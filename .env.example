# Supabase — same project as the admin app, so the catalogue is shared.
# Both values are safe in the browser; RLS decides what they can reach.
# Never add the service_role key: this site is a static export.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# EmailJS (already live) — public by design, restricted by domain allow-list.
# NEXT_PUBLIC_EMAILJS_SERVICE_ID=
# NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
# NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Turns on the LMS surfaces that are not open to the public yet: the LMS nav
# item, the learner bar and sign-in on programme pages, and enrolment through
# the simulated payment gateway. Set to 1 for a testing build only — never in
# the production deploy, and no real money moves either way.
# NEXT_PUBLIC_LMS_TESTING=1

# Razorpay. The key id is public — it appears in the checkout URL of every
# Razorpay site — so it belongs here. The key SECRET must never be in this repo
# or in any NEXT_PUBLIC_* variable: this site is a static export and the bundle
# is readable by anyone. It goes in razorpay-config.php above the web root.
# Leave the key id unset and checkout falls back to the simulated gateway.
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# Where the PHP payment endpoints live. Empty = same origin, which is right for
# the deployed site. `next dev` cannot serve PHP, so a local build points at the
# deployed origin instead; the endpoints accept localhost only while the key
# configured on the server is a test key.
# NEXT_PUBLIC_PAYMENT_API_BASE=https://levitatepeoplesoft.com

# Set to "off" to open enrolment without payment: the Enrol button enrols on
# the spot, no gateway and no card. Enrolment opens on its own when this is set
# — a free course nobody can click into is just a closed course. Unset it and
# payment goes back to Razorpay (or the simulation, if no key is configured).
# NEXT_PUBLIC_PAYMENT_MODE=off
