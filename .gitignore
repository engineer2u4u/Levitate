# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local agent/editor config
.claude/

# Large media: GitHub hard-rejects files over 100 MB, and video does not
# belong in git history. Upload these straight to the host instead.
/public/assets/*.mp4
/public/assets/*.mov
/public/assets/*.webm
*.crdownload

# Unoptimised source images kept locally for re-cropping. The site references
# the resized copies (parichita-full.jpg, ravindra-full.jpg), so keep the
# 15 MB originals out of git history.
/public/assets/Parichita full.jpeg
/public/assets/Ravindra Prem Nath - full.png

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
